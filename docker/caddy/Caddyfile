# Caddy obtains and renews the certificate itself. The domain must already
# resolve to this server, or the certificate request fails and the site stays
# on HTTP - which PayTabs will not call back to.

{$APP_DOMAIN} {
	encode zstd gzip

	# PayTabs signs the webhook over the raw request body, so nothing here may
	# rewrite or re-encode it on the way through.
	reverse_proxy nginx:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
