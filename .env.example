APP_NAME=UAEERF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mssql

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Application staging tables (payment_transactions, rider_registrations,
# rider_renewals, show_jumping_entries). Local SQL Server or the Docker service.
MSSQL_HOST=your_host
MSSQL_PORT=1433
MSSQL_DATABASE=your_database
MSSQL_USERNAME=your_username
MSSQL_PASSWORD=your_password
MSSQL_ENCRYPT=no
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Live UAEERF federation database (eefsys.WebUserProfile, eefsys.ClassEntriesWeb).
# NOTE: the database is named EEF. There is no EEFRegistration database on the
# server - connecting with that name fails with "Msg 4060: Cannot open database".
# DEVSQL is a named instance reached over its static port, so the host carries
# the hostname only and the instance name is omitted.
# Requires the sqlsrv PHP extension.
FEDERATION_DB_HOST=your_host
FEDERATION_DB_PORT=50441
FEDERATION_DB_DATABASE=EEF
FEDERATION_DB_USERNAME=your_username
FEDERATION_DB_PASSWORD=your_password
FEDERATION_DB_ENCRYPT=no
FEDERATION_DB_TRUST_SERVER_CERTIFICATE=true

# SOAP Web Services
SOAP_AUTH_URL=http://wsdev.emiratesequestrian.ae/webservices/WSAuthentication.asmx
SOAP_REGISTRATIONS_URL=http://wsdev.emiratesequestrian.ae/webservices/WSRegistrations.asmx
SOAP_RIDERS_URL=http://wsdev.emiratesequestrian.ae/webservices/WSRiders.asmx
SOAP_HORSES_URL=http://wsdev.emiratesequestrian.ae/webservices/WSHorses.asmx
SOAP_CALENDAR_URL=http://wsdev.emiratesequestrian.ae/webservices/WSCalendar.asmx
SOAP_COMMONS_URL=http://wsdev.emiratesequestrian.ae/webservices/WSCommons.asmx
SOAP_COMMON_OPS_URL=http://wsdev.emiratesequestrian.ae/webservices/WSCommonOperations.asmx
SOAP_JUMPING_CRITERIA_URL=http://wsdev.emiratesequestrian.ae/webservices/ShowJumpingCriteria.asmx

# SOAP Web Service credentials
SOAP_AUTH_USERNAME=your_soap_username
SOAP_AUTH_PASSWORD=your_soap_password

# Login verifies against eefsys.WebUserProfile. Set true only for local
# development without an MSSQL connection - it allows login against the local
# users table when the federation database is unreachable.
FEDERATION_ALLOW_LOCAL_AUTH_FALLBACK=false

# WSHorses.SearchHorseListV5 does not respond within 120s on the dev server, so
# horse lookups read eefsys.HorseMaster directly. Set true once it is usable.
SOAP_HORSES_VIA_WEBSERVICE=false

# WSDLs are static contracts. Caching them to disk avoids a ~100ms remote fetch
# every time a SOAP client is constructed. Set false only when a WSDL changes.
SOAP_CACHE_WSDL=true

# PayTabs Sandbox (candidates must use their own)
PAYTABS_PROFILE_ID=your_profile_id
PAYTABS_SERVER_KEY=your_server_key

# Shown to customers whose payment succeeded but whose federation submission
# did not, so they have a route to a refund. Leave blank to hide the link.
PAYTABS_SUPPORT_EMAIL=
PAYTABS_CALLBACK_URL=https://your-domain.com/api/paytabs/callback
PAYTABS_RETURN_URL=https://your-domain.com/payment/return
